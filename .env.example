# ---------------------------------------------------------------------------
# Shorts Factory configuration. Copy to .env and fill in the values.
# Never commit .env. Secrets are only read on the server and never reach the browser.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
# Public base URL of the app (used for OAuth redirects and secure cookies).
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://shorts:shorts@localhost:5432/shorts_factory
REDIS_URL=redis://localhost:6379

# Security
# Random string of at least 32 characters: openssl rand -base64 48
AUTH_SECRET=
# 32 random bytes, base64 encoded (encrypts OAuth tokens at rest): openssl rand -base64 32
ENCRYPTION_KEY=
# The first account becomes the admin; set to true to allow further self-registration.
ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------------
# FREE MODE (default): no paid APIs.
#  - Text: Ollama running locally (https://ollama.com): `ollama pull qwen2.5:7b`
#  - Voice: Kokoro, subtitles: Parakeet - run inside the worker, models download
#    automatically on first use (~600 MB total) into LOCAL_MODELS_DIR.
#  - Footage: Pexels (free key). Publishing: YouTube API (free).
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LOCAL_MODELS_DIR=./storage/models
# CPU threads for the local voice/subtitle engines
LOCAL_AI_THREADS=4

# OPTIONAL paid providers (select them in Settings if you want higher quality)
# AI (Anthropic Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=
# Default model; can be changed per user in Settings.
ANTHROPIC_MODEL=claude-opus-5

# Text-to-speech + speech-to-text (ElevenLabs) - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional alternative speech-to-text (OpenAI Whisper)
OPENAI_API_KEY=

# Stock footage (Pexels, FREE key) - https://www.pexels.com/api/
PEXELS_API_KEY=8EVoiUwcI5A2CQtch9t83xgvTwujQAWTbL2avGp0jaHqlAcHlA5GydQ7

# YouTube Data API v3 / OAuth 2.0 (Google Cloud Console -> Credentials -> OAuth client ID, "Web application")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must match an authorised redirect URI of the OAuth client exactly.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Storage: "local" (development / single host) or "s3" (any S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3 settings (only when STORAGE_DRIVER=s3)
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_FORCE_PATH_STYLE=true

# Media tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONTS_DIR=/usr/share/fonts/truetype
WORK_DIR=./storage/tmp

# Worker
WORKER_CONCURRENCY=2
RENDER_CONCURRENCY=1
LOG_LEVEL=info

# Docker Compose only
POSTGRES_PASSWORD=shorts
APP_PORT=3000
