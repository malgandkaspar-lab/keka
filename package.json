    "@googleapis/youtubeanalytics": "^11.0.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "an-array-of-english-words": "^2.0.0",
    "bullmq": "^6.3.9",
    "dotenv": "^18.0.4",
    "franc": "^6.2.0",
    "google-auth-library": "^11.1.0",
    "ioredis": "^6.0.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
